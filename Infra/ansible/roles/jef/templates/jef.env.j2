# Managed by Ansible -- edits will be overwritten.
JEF_BACKBONE={{ jef_backbone }}
JEF_PORT={{ jef_port }}
JEF_WORKERS={{ jef_workers }}
JEF_ALPHA={{ jef_alpha }}
JEF_LOG_LEVEL={{ jef_log_level }}
JEF_MAX_QUESTIONS={{ jef_max_questions }}
# Intra-op threads for the frozen backbone. Set below the vCPU count on purpose:
# oversubscribing this pool on a CPU-only box makes p99 worse, not better.
JEF_THREADS={{ jef_threads }}
HF_HOME=/cache/huggingface
{% if jef_head_path | length %}
JEF_HEAD_PATH={{ jef_head_path }}
{% endif %}
{% if jef_calibration_path | length %}
JEF_CALIBRATION_PATH={{ jef_calibration_path }}
{% endif %}
