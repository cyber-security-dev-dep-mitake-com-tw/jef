# Managed by Ansible -- edits will be overwritten.
services:
  jef:
    image: {{ jef_image }}
    container_name: jef
    restart: {{ jef_restart_policy }}
    env_file: {{ jef_home }}/jef.env
    ports:
      - "{{ jef_port }}:{{ jef_port }}"
    volumes:
      # Model weights persist across restarts; re-downloading 300M parameters
      # on every deploy is a self-inflicted outage.
      - {{ jef_cache_dir }}:/cache/huggingface
    deploy:
      resources:
        limits:
          cpus: "{{ ansible_processor_vcpus }}"
          memory: {{ jef_memory_limit }}
    healthcheck:
      test: ["CMD", "python", "-c", "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:{{ jef_port }}/healthz',timeout=2).status==200 else 1)"]
      interval: 30s
      timeout: 3s
      start_period: 120s
      retries: 3
    logging:
      driver: json-file
      options:
        max-size: "20m"
        max-file: "5"
