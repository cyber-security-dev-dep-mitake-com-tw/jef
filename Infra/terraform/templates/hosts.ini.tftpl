# Generated by Terraform -- do not edit by hand, and never commit this file.
# `terraform apply` rewrites it; it is gitignored because it names live hosts.

[jef]
%{ for h in hosts ~}
${h.name} ansible_host=${h.address}
%{ endfor ~}

[jef:vars]
ansible_user=jef
ansible_python_interpreter=/usr/bin/python3

jef_image=${jef_image}
jef_backbone=${jef_backbone}
# Intra-op threads, deliberately below vcpus (${vcpus}) -- see Infra/README.md.
jef_threads=${jef_threads}
