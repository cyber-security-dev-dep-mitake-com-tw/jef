<%- | String $backbone, Integer $port, Integer $workers, String $alpha,
      String $log_level, Integer $max_questions, Integer $threads,
      String $head_path, String $calibration_path | -%>
# Managed by Puppet -- edits will be overwritten.
JEF_BACKBONE=<%= $backbone %>
JEF_PORT=<%= $port %>
JEF_WORKERS=<%= $workers %>
JEF_ALPHA=<%= $alpha %>
JEF_LOG_LEVEL=<%= $log_level %>
JEF_MAX_QUESTIONS=<%= $max_questions %>
JEF_THREADS=<%= $threads %>
HF_HOME=/cache/huggingface
<% unless empty($head_path) { -%>
JEF_HEAD_PATH=<%= $head_path %>
<% } -%>
<% unless empty($calibration_path) { -%>
JEF_CALIBRATION_PATH=<%= $calibration_path %>
<% } -%>
