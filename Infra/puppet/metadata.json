{
  "name": "mitake-jef",
  "version": "0.1.0",
  "author": "Mitake Cyber Security Dev Dept",
  "summary": "Deploys the JEF System One decision engine (CPU-only)",
  "license": "Apache-2.0",
  "source": "https://github.com/cyber-security-dev-dep-mitake-com-tw/jef",
  "dependencies": [
    { "name": "puppetlabs/stdlib", "version_requirement": ">= 9.0.0 < 10.0.0" },
    { "name": "puppetlabs/apt", "version_requirement": ">= 9.0.0 < 11.0.0" }
  ],
  "operatingsystem_support": [
    { "operatingsystem": "Debian", "operatingsystemrelease": ["12"] },
    { "operatingsystem": "Ubuntu", "operatingsystemrelease": ["22.04", "24.04"] }
  ],
  "requirements": [
    { "name": "puppet", "version_requirement": ">= 7.0.0 < 9.0.0" }
  ]
}
